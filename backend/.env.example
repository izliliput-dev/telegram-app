# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Web App URL (ваш домен или localhost для тестов)
WEB_APP_URL=https://your-domain.com

# Secret key для шифрования данных (минимум 32 символа)
ENCRYPTION_KEY=your-secret-key-at-least-32-characters-long

# Путь к хранилищу данных
STORAGE_PATH=./storage

# Порт для запуска backend
PORT=8000
